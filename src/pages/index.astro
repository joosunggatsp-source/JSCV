---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import { href } from '../lib/url';
import { getCollection } from 'astro:content';
import { groupBySection } from '../lib/work';

const groups = groupBySection(site.sections, await getCollection('projects'));
---
<Base title={site.name}>
  <p class="tagline">{site.tagline}</p>

  <section id="about">
    <h2>About</h2>
    {site.about.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <div id="work">
    {groups.map(({ section, items }) => (
      <section id={section.id}>
        <h2>{section.title}</h2>
        {items.length === 0 ? (
          <p class="muted">[Nothing here yet]</p>
        ) : (
          <ul class="rows">
            {items.map((project) => (
              <li>
                <h3>
                  {project.data.details ? (
                    <a href={href(`projects/${project.id}/`)}>{project.data.title}</a>
                  ) : (
                    project.data.title
                  )}
                </h3>
                <div class="detail">
                  {project.data.summary}
                  {project.data.tags.length > 0 && (
                    <div class="tags">{project.data.tags.join(' · ')}</div>
                  )}
                </div>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}
  </div>

  <section id="cv">
    <h2>CV</h2>
    <ul class="rows">
      {site.cv.groups.map((group) => (
        <li>
          <h3>{group.title}</h3>
          <ul class="detail">
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </li>
      ))}
    </ul>
    {site.cv.pdf && <p><a href={href(site.cv.pdf)}>CV (PDF)</a></p>}
  </section>

  <section id="contact">
    <h2>Contact</h2>
    <ul class="inline-list">
      {site.contact.map((entry) => (
        <li>{entry.url ? <a href={entry.url}>{entry.label}</a> : entry.label}</li>
      ))}
    </ul>
  </section>
</Base>
